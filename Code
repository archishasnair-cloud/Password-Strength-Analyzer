import re
import random

old_passwords = ["Archu@123", "Password@123", "Hello@123"]

def check_password(password):
    score = 0
    suggestions = []

    if len(password) >= 8:
        score += 1
    else:
        suggestions.append("Use at least 8 characters")

    if re.search(r"[A-Z]", password):
        score += 1
    else:
        suggestions.append("Add uppercase letters")

    if re.search(r"[a-z]", password):
        score += 1
    else:
        suggestions.append("Add lowercase letters")

    if re.search(r"[0-9]", password):
        score += 1
    else:
        suggestions.append("Add numbers")

    if re.search(r"[^A-Za-z0-9]", password):
        score += 1
    else:
        suggestions.append("Add special characters like @, #, $")

    if password not in old_passwords:
        score += 1
    else:
        suggestions.append("Do not reuse old passwords")

    print("\nPassword Analysis:")

    if score <= 2:
        print("Strength: Weak")
    elif score <= 4:
        print("Strength: Medium")
    else:
        print("Strength: Strong")

    if suggestions:
        print("\nSuggestions:")
        for s in suggestions:
            print("-", s)

    print("\nSuggested Strong Password:", generate_password())


def generate_password():
    words = ["Tiger", "Moon", "River", "Cloud", "Star"]
    symbols = ["@", "#", "$", "&", "!"]
    return random.choice(words) + str(random.randint(100, 999)) + random.choice(symbols)


print("Password Strength Analyzer")

password = input("Enter your password: ")
check_password(password)
